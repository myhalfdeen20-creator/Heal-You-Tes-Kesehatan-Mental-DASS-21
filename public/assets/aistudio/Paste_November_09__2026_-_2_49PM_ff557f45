    [
      "Saat mulai kesal, tunda reaksi 10 detik sambil menarik napas panjang sebelum menjawab.",
      "Kenali pemicumu seperti lapar, kurang tidur, atau terburu-buru, lalu atasi dasarnya lebih dulu."
    ]
  ]
};

const SP = {
  d: [
    "Mulai harimu dengan satu amalan ringan yang konsisten, misalnya dua rakaat dhuha atau membaca satu halaman Al-Qur’an. Yang kecil tetapi rutin lebih menenangkan daripada target besar.",
    "Ingat bahwa setiap manusia berharga di sisi Allah. Ceritakan isi hatimu dalam doa, tanpa menahan atau menghakimi dirimu sendiri."
  ],
  a: [
    "Perlambat napas sambil berdzikir pelan seperti tasbih atau istighfar. Kamu juga bisa membaca doa berlindung dari gelisah dan sedih: Allahumma inni a’udzu bika minal hammi wal hazan.",
    "Berdzikir pelan sambil menarik napas panjang membantu hatimu kembali ke saat ini, sambil tetap berikhtiar menghadapi sebab ketakutanmu."
  ],
  s: [
    "Beri jeda dengan wudhu dan shalat tepat waktu, atau duduk tenang sejenak. Jeda ibadah bisa menjadi tempat tubuh dan pikiran beristirahat.",
    "Saat marah, ucapkan ta’awudz, ubah posisi dari berdiri ke duduk, atau diam sejenak, sebagaimana dituntunkan Rasulullah ﷺ."
  ]
};

const RM = {
  d: "Maka sesungguhnya bersama kesulitan ada kemudahan. (QS. Al-Insyirah: 5–6)",
  a: "Ingatlah, hanya dengan mengingat Allah hati menjadi tenteram. (QS. Ar-Ra’d: 28)",
  s: "Allah tidak membebani seseorang melainkan sesuai dengan kesanggupannya. (QS. Al-Baqarah: 286)"
};

const $ = id => document.getElementById(id);
const reduce = matchMedia("(prefers-reduced-motion:reduce)").matches;
const LV = {};
let i = 0, ans = [], lock = false, out = "";

const cs = k => C[k].map((c, idx) => ({
  i: idx,
  n: c[0],
  m: c[1].reduce((s, j) => s + ans[j], 0) / c[1].length
}));

const dom = k => {
  const a = cs(k);
  return a[1].m > a[0].m ? a[1] : a[0];
};

const sp = k => SP[k][dom(k).i];
const max3 = () => Object.values(LV).some(v => v >= 3);

function pola(k, lv) {
  if (!lv) return "";
  const a = cs(k), d = dom(k);
  return '<h4>Pola gejalamu</h4>' +
    a.map(c => '<div class="cl"><span>' + c.n + '</span><i><b style="width:' + (c.m / 3 * 100) + '%"></b></i></div>').join("") +
    '<p>' + (Math.abs(a[0].m - a[1].m) < 0.5 ? 'Kedua kelompok gejala terasa hampir sama kuat.' : 'Gejalamu paling terasa pada <b>' + d.n.toLowerCase() + '</b>.') + '</p>';
}

function tips(k) {
  const a = cs(k), d = dom(k), o = a[1 - d.i], t = CT[k][d.i].slice();
  if (o.m >= 1.5) t.push(CT[k][o.i][0]);
  return t;
}

function plan(f) {
  const p = P[f];
  const days = [
    "Catat suasana hatimu (1 sampai 10) pagi dan malam, juga jam tidurmu.",
    p[0],
    p[1],
    sp(f),
    p[2],
    "Hubungi satu orang yang membuatmu merasa aman dan ceritakan satu hal yang kamu rasakan, lalu tutup hari dengan doa dan syukur.",
    "Tinjau catatanmu: apa yang paling membantu? Lanjutkan itu, dan ulangi tes setelah 2 sampai 4 minggu."
  ];
  return '<h3>Rencana 7 hari: fokus pada ' + D[f].n.toLowerCase() + '</h3>' +
    '<p>Satu langkah kecil per hari. Tidak apa-apa melewatkan satu hari, lanjutkan saja besoknya.' + (max3() ? ' Rencana ini pendamping, bukan pengganti bantuan profesional.' : '') + '</p>' +
    '<p><b>Pengingat hati:</b> ' + RM[f] + '</p>' +
    '<ol>' + days.map(x => '<li>' + x + '</li>').join("") + '</ol>';
}

function deep(k, lv) {
  const top = Q.map((q, j) => [q[0], ans[j], q[1]])
    .filter(x => x[2] === k && x[1] >= 2)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3);
  return '<details' + (lv ? ' open' : '') + '><summary>Analisis mendalam</summary>' +
    '<p>' + M[k] + '</p><p>' + TL[lv] + '</p>' + pola(k, lv) +
    (top.length ? '<h4>Yang paling terasa olehmu</h4><ul>' + top.map(x => '<li>' + x[0] + ' (' + O[x[1]][0].toLowerCase() + ')</li>').join("") + '</ul>' : '') +
    '<h4>' + (lv ? 'Langkah pemulihan' : 'Menjaga kondisi tetap baik') + '</h4>' +
    (lv ? '<ul>' + tips(k).concat(sp(k)).map(x => '<li>' + x + '</li>').join("") + '</ul>' : '<p>Pertahankan tidur cukup, gerak rutin, dan ruang untuk bercerita kepada orang terdekat.</p>') +
    '</details>';
}

function summary(max) {
  let g = '<b>Gambaran umum</b><br>';
  if (!max) return g + 'Ketiga aspek berada dalam rentang normal. Pertahankan rutinitas yang membuatmu merasa baik, dan ulangi tes bila kondisimu berubah.';
  const hi = ["d", "a", "s"].filter(k => LV[k] === max).map(k => D[k].n.toLowerCase());
  g += 'Aspek yang paling menonjol: ' + hi.join(", ") + ' (tingkat ' + L[max].toLowerCase() + '). ';
  if (LV.a >= 2 && LV.s >= 2) g += 'Kecemasan dan stres yang tinggi bersamaan sering menandakan tubuh dan pikiran terlalu lama dalam mode siaga, sehingga istirahat terasa kurang memulihkan. ';
  if (LV.d >= 2 && (LV.a >= 2 || LV.s >= 2)) g += 'Suasana hati yang turun disertai ketegangan bisa saling memperkuat: lelah membuat sulit bergerak, dan tidak bergerak memperpanjang lelah. ';
  if (LV.d >= 2 && LV.a < 2 && LV.s < 2) g += 'Gejalanya cenderung tenang di luar: tidak banyak ketegangan, tetapi energi dan minat menurun. Pola ini mudah terlewat orang sekitar, jadi mengutarakannya langsung itu penting. ';
  return g + 'Mulailah dari satu langkah kecil pada aspek tertinggi, lalu lihat perubahannya dalam beberapa minggu.';
}

// Inisialisasi bar progres dan tombol opsi sekali saja agar fokus keyboard tidak hilang
$("bar").innerHTML = "<i></i>".repeat(21);
const optBtns = O.map((o, v) => {
  const b = document.createElement("button");
  b.type = "button";
  b.innerHTML = '<span class="dot">' + v + '</span><span><b>' + o[0] + '</b><small>' + o[1] + '</small></span>';
  b.onclick = () => pick(v);
  $("opts").appendChild(b);
  return b;
});

function show(id) {
  ["intro", "quiz", "result"].forEach(s => $(s).hidden = s !== id);
  const h = $(id).querySelector("h1,h2");
  h.focus({ preventScroll: true });
  window.scrollTo(0, 0);
}

function render() {
  $("n").textContent = i + 1;
  $("q").textContent = Q[i][0];
  document.querySelectorAll("#bar i").forEach((e, k) => e.className = k < i ? "on" : k === i ? "cur" : "");
  optBtns.forEach((b, v) => b.setAttribute("aria-pressed", ans[i] === v));
  $("back").disabled = i === 0;
  $("next").hidden = ans[i] === undefined;
}

function pick(v) {
  if (lock) return;
  ans[i] = v;
  lock = true;
  render();
  setTimeout(() => {
    lock = false;
    if (i < Q.length - 1) {
      i++;
      render();
    } else {
      finish();
    }
  }, reduce ? 0 : 260);
}

function begin() {
  i = 0;
  ans = [];
  render();
  show("quiz");
}

function finish() {
  const sc = { d: 0, a: 0, s: 0 };
  Q.forEach((q, k) => sc[q[1]] += ans[k]);
  const box = $("cards");
  box.innerHTML = "";
  let max = 0;
  const lines = ["Hasil DASS-21 saya:"];
  ["d", "a", "s"].forEach(k => {
    const s = sc[k] * 2, t = D[k].t, lv = t.filter(x => s >= x).length;
    max = Math.max(max, lv);
    LV[k] = lv;
    lines.push(D[k].n + ": " + s + " (" + L[lv] + ")");
    const c = document.createElement("article");
    c.className = "card";
    c.style.setProperty("--lc", "var(--l" + lv + ")");
    c.innerHTML = '<div class="top"><h3>' + D[k].n + '</h3><span class="lv">' + L[lv] + '</span></div>' +
      '<div class="sc"><b>' + s + '</b><span>dari 42</span></div>' +
      '<div class="trk"><div class="fill" style="width:' + (s / 42 * 100) + '%"></div>' +
      t.map(x => '<span style="left:' + (x / 42 * 100) + '%"></span>').join("") + '</div>' +
      '<p>' + T[lv] + '</p>' + deep(k, lv);
    box.appendChild(c);
  });
  $("sum").innerHTML = summary(max);
  const f = ["d", "a", "s"].sort((x, y) => LV[y] - LV[x] || sc[y] - sc[x])[0];
  $("plan").hidden = !max;
  if (max) $("plan").innerHTML = plan(f);
  $("care").hidden = !(ans[20] >= 1 || max >= 3);
  out = lines.join("\n");
  show("result");
}

$("start").onclick = begin;
$("again").onclick = begin;
$("back").onclick = () => {
  if (i > 0 && !lock) {
    i--;
    render();
  }
};
$("next").onclick = () => {
  if (ans[i] !== undefined && !lock) {
    if (i < Q.length - 1) {
      i++;
      render();
    } else {
      finish();
    }
  }
};
$("copy").onclick = async () => {
  const b = $("copy");
  try {
    await navigator.clipboard.writeText(out);
    b.textContent = "Tersalin";
  } catch (e) {
    b.textContent = "Tidak bisa menyalin";
  }
  setTimeout(() => b.textContent = "Salin hasil", 1800);
};

// Pengendali tema gelap/terang
const root = document.documentElement;
const darkMedia = matchMedia("(prefers-color-scheme:dark)");
function syncThemeBtn() {
  const isDark = root.dataset.theme ? root.dataset.theme === "dark" : darkMedia.matches;
  $("theme").textContent = isDark ? "Mode terang" : "Mode gelap";
}
$("theme").onclick = () => {
  const isDark = root.dataset.theme ? root.dataset.theme === "dark" : darkMedia.matches;
  root.dataset.theme = isDark ? "light" : "dark";
  syncThemeBtn();
};
syncThemeBtn();

document.addEventListener("keydown", e => {
  if ($("quiz").hidden || e.metaKey || e.ctrlKey || e.altKey || lock) return;
  if (/^[0-3]$/.test(e.key)) {
    pick(+e.key);
  } else if (e.key === "ArrowLeft" && i > 0) {
    i--;
    render();
  } else if (e.key === "ArrowRight" && ans[i] !== undefined) {
    if (i < Q.length - 1) {
      i++;
      render();
    } else {
      finish();
    }
  }
});
</script>
</body>
</html>